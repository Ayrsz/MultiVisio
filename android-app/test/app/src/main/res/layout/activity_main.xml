<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F5F9">

    <!-- Zone dans laquelle les 3 pages seront affichées -->
    <FrameLayout
        android:id="@+id/conteneurFragments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Barre de navigation fixe en bas -->
    <LinearLayout
        android:id="@+id/barreNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:background="#142238"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/navAlertes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconeAlertes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/labelAlertes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertes"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCameras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconeCameras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📹"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/labelCameras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Caméras"
                android:textColor="#AAB7CA"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDrone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconeDrone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚁"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/labelDrone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drone"
                android:textColor="#AAB7CA"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
